---
import Icone from "../Icone.astro";
import Secao from "../Secao.astro";
import Titulo from "../Titulo.astro";
import { IDEAL_PARA } from "../../lib/conteudo";
---

<Secao id="ideal" class="bg-white">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div>
      <Titulo linhas={IDEAL_PARA.titulo} />
      <p class="garrafal-sm mt-8 max-w-md border-l-4 border-brand pl-5 text-xl text-navy" data-anim="sobe">{IDEAL_PARA.frase}</p>
    </div>
    <ul class="carrossel grid gap-3 sm:grid-cols-2 [--slide:78%]" data-anim-grupo>
      {IDEAL_PARA.itens.map((i) => (
        <li class="flex items-start gap-4 rounded-card border border-line bg-canvas p-5" data-anim="cartao">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white text-brand shadow-card">
            <Icone nome={i.icone} class="size-5" />
          </span>
          <p class="pt-1.5 font-medium leading-snug text-navy">{i.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</Secao>
