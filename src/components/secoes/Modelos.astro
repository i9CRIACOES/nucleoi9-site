---
import Icone from "../Icone.astro";
import Secao from "../Secao.astro";
import Titulo from "../Titulo.astro";
import { MODELOS } from "../../lib/conteudo";
---

<Secao id="modelos">
  <div class="grid items-end gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-chip px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-brand" data-anim="sobe">
        <Icone nome="LayoutGrid" class="size-4" />
        {MODELOS.selo}
      </p>
      <Titulo linhas={MODELOS.titulo} />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted" data-anim="sobe">{MODELOS.sub}</p>
    </div>
    <div class="rounded-card bg-navy p-8 text-white shadow-card lg:p-10" data-anim="sobe">
      <p class="garrafal text-[clamp(4.5rem,12vw,8.5rem)] leading-none text-white">
        {MODELOS.numero}<span class="text-brand">+</span>
      </p>
      <p class="mt-3 max-w-xs text-lg font-medium text-white/80">{MODELOS.numeroRotulo}</p>
    </div>
  </div>

  <div class="mt-14">
    <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.12em] text-muted" data-anim="sobe">{MODELOS.segmentosTitulo}</h3>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" data-anim-grupo>
      {MODELOS.segmentos.map((s) => (
        <li class="flex items-center gap-3 rounded-card border border-line bg-white p-4" data-anim="cartao">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-chip text-brand">
            <Icone nome={s.icone} class="size-5" />
          </span>
          <span class="font-semibold text-navy">{s.nome}</span>
        </li>
      ))}
      <li class="flex items-center justify-center rounded-card border border-dashed border-brand/40 p-4 text-center text-sm font-medium text-brand" data-anim="cartao">
        e o seu negócio
      </li>
    </ul>
  </div>

  <div class="mt-12 grid items-center gap-8 rounded-card border border-line bg-white p-6 lg:grid-cols-[auto_1fr] lg:p-8">
    <h3 class="garrafal-sm text-2xl text-navy" data-anim="sobe">{MODELOS.funcoesTitulo}</h3>
    <ul class="flex flex-wrap gap-2.5" data-anim-grupo>
      {MODELOS.funcoes.map((f) => (
        <li class="inline-flex items-center gap-2 rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white" data-anim="cartao">
          <Icone nome={f.icone} class="size-4 text-brand" />
          {f.nome}
        </li>
      ))}
    </ul>
  </div>

  <p class="garrafal-sm mt-12 max-w-2xl border-l-4 border-brand pl-5 text-2xl text-navy" data-anim="sobe">
    {MODELOS.fecho[0]}<br />{MODELOS.fecho[1]}
  </p>
</Secao>
