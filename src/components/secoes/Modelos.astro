---
import Icone from "../Icone.astro";
import Secao from "../Secao.astro";
import Titulo from "../Titulo.astro";
import { MODELOS } from "../../lib/conteudo";

// Fotos em órbita em volta do robô (posições em % do quadro).
const orbita = [
  { x: 50, y: 12 },
  { x: 88, y: 50 },
  { x: 50, y: 88 },
  { x: 12, y: 50 },
];
---

<Secao id="modelos">
  <div class="grid items-end gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-14">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-chip px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-brand" data-anim="sobe">
        <Icone nome="LayoutGrid" class="size-4" />
        {MODELOS.selo}
      </p>
      <Titulo linhas={MODELOS.titulo} />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted" data-anim="sobe">{MODELOS.sub}</p>
    </div>

    <!-- Cartão do número: 140+ à esquerda, robô com agentes em órbita à direita -->
    <div class="relative overflow-hidden rounded-panel bg-navy text-white shadow-soft" data-anim="sobe">
      <div class="pointer-events-none absolute -right-20 -top-24 size-72 rounded-full bg-brand/40 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-28 -left-16 size-64 rounded-full bg-brand-light/20 blur-3xl"></div>
      <div class="relative grid items-center gap-6 p-7 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-9">
        <div>
          <p class="garrafal text-[clamp(4.5rem,11vw,7.5rem)] leading-[0.9] text-white">
            {MODELOS.numero}<span class="text-brand-light">+</span>
          </p>
          <p class="mt-3 text-xl font-semibold leading-snug text-white">{MODELOS.numeroRotulo}</p>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/70">{MODELOS.numeroApoio}</p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <div class="flex shrink-0 -space-x-3">
              {MODELOS.agentes.map((a) => (
                <img src={a.foto} alt="" width="40" height="40" loading="lazy" class="size-10 rounded-full object-cover ring-2 ring-navy" />
              ))}
              <span class="flex size-10 items-center justify-center rounded-full bg-brand text-xs font-bold ring-2 ring-navy">+136</span>
            </div>
            <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-white/10 px-2.5 py-1 text-xs font-semibold">
              <span class="size-2 rounded-full bg-success"></span>
              Prontos para atender
            </span>
          </div>
        </div>

        <div class="relative mx-auto aspect-square w-[min(230px,66vw)] lg:w-[190px]" aria-hidden="true">
          <div class="absolute inset-[12%] rounded-full border border-dashed border-white/20 [animation:giraLento_40s_linear_infinite]"></div>
          <div class="absolute inset-[30%] rounded-full bg-brand/40 blur-xl"></div>
          <div class="absolute inset-[30%] flex items-center justify-center rounded-full bg-[radial-gradient(circle_at_35%_30%,#2790d2_0%,#0075be_55%,#00649b_100%)] ring-8 ring-white/5">
            <Icone nome="Bot" class="size-[52%]" strokeWidth={1.6} />
            <span class="absolute right-[12%] top-[12%] size-3 rounded-full bg-success ring-4 ring-navy"></span>
          </div>
          <div class="absolute inset-0 [animation:giraLento_40s_linear_infinite]">
            {MODELOS.agentes.map((a, i) => (
              <span class="absolute w-max -translate-x-1/2 -translate-y-1/2" style={`left:${orbita[i].x}%;top:${orbita[i].y}%`}>
                <img src={a.foto} alt="" width="52" height="52" loading="lazy" class="size-12 max-w-none rounded-full object-cover shadow-soft ring-4 ring-navy [animation:giraLento_40s_linear_infinite_reverse]" />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Segmentos -->
  <div class="mt-16">
    <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.12em] text-muted" data-anim="sobe">{MODELOS.segmentosTitulo}</h3>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" data-anim-grupo>
      {MODELOS.segmentos.map((s) => (
        <li class="flex items-center gap-3 rounded-card border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-soft" data-anim="cartao">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-chip text-brand">
            <Icone nome={s.icone} class="size-5" />
          </span>
          <span class="font-semibold text-navy">{s.nome}</span>
        </li>
      ))}
      <li class="flex items-center justify-center rounded-card border border-dashed border-brand/40 p-4 text-center text-sm font-medium text-brand" data-anim="cartao">
        e o seu negócio
      </li>
    </ul>
  </div>

  <!-- Especialidades -->
  <div class="mt-14">
    <h3 class="garrafal-sm mb-6 text-2xl text-navy sm:text-3xl" data-anim="sobe">{MODELOS.funcoesTitulo}</h3>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7" data-anim-grupo>
      {MODELOS.funcoes.map((f) => (
        <li class="group flex flex-col items-center last:col-span-2 sm:last:col-span-1 rounded-panel border border-line bg-white px-3 pb-5 pt-6 text-center transition hover:-translate-y-1 hover:shadow-soft" data-anim="cartao">
          <span class="relative mb-4 flex size-16 items-center justify-center rounded-2xl bg-[linear-gradient(145deg,#2790d2_0%,#0075be_60%,#00649b_100%)] text-white shadow-soft transition group-hover:scale-105">
            <span class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/25"></span>
            <Icone nome={f.icone} class="size-7" strokeWidth={1.7} />
          </span>
          <span class="font-semibold text-navy">{f.nome}</span>
          <span class="mt-1 text-xs leading-snug text-muted">{f.texto}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Três passos -->
  <div class="mt-16 overflow-hidden rounded-panel bg-navy p-7 text-white sm:p-10" data-anim="sobe">
    <Titulo linhas={MODELOS.passosTitulo} claro class="!text-[clamp(1.7rem,3.6vw,2.6rem)]" />
    <ol class="relative mt-9 grid gap-4 md:grid-cols-3 md:gap-6" data-anim-grupo>
      <div class="pointer-events-none absolute left-[16%] right-[16%] top-9 hidden h-px bg-[linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent)] md:block" aria-hidden="true"></div>
      {MODELOS.passos.map((p, i) => (
        <li class="relative rounded-card border border-white/10 bg-white/5 p-6 backdrop-blur" data-anim="cartao">
          <div class="mb-4 flex items-center gap-3">
            <span class="flex size-[72px] shrink-0 flex-col items-center justify-center rounded-2xl bg-brand text-white shadow-soft">
              <Icone nome={p.icone} class="size-6" strokeWidth={1.8} />
              <span class="mt-1 text-[11px] font-bold tracking-wider text-white/80">{p.num}</span>
            </span>
            <span class="garrafal text-4xl text-white">{p.nome}</span>
            {i < MODELOS.passos.length - 1 && (
              <Icone nome="ArrowRight" class="ml-auto hidden size-5 text-brand-light md:block" />
            )}
          </div>
          <p class="text-sm leading-relaxed text-white/75">{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</Secao>
