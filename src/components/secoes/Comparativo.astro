---
import Icone from "../Icone.astro";
import Secao from "../Secao.astro";
import Titulo from "../Titulo.astro";
import { COMPARATIVO } from "../../lib/conteudo";
---

<Secao id="comparativo" class="bg-white">
  <div class="mb-10 max-w-3xl">
    <Titulo linhas={COMPARATIVO.titulo} />
    <p class="mt-5 text-lg text-muted" data-anim="sobe">{COMPARATIVO.sub}</p>
  </div>

  <div class="overflow-hidden rounded-panel border border-line shadow-card" data-anim="sobe">
    <table class="w-full border-collapse text-left text-sm">
      <thead class="bg-canvas text-[11px] font-bold uppercase tracking-[0.14em] text-muted">
        <tr>
          <th scope="col" class="px-4 py-3 sm:px-6">Ferramenta</th>
          <th scope="col" class="hidden px-4 py-3 md:table-cell md:px-6">Custo separado</th>
          <th scope="col" class="px-4 py-3 text-right text-brand sm:px-6">No Núcleo i9</th>
        </tr>
      </thead>
      <tbody data-anim-grupo>
        {COMPARATIVO.linhas.map((l) => (
          <tr class="border-t border-line" data-anim="cartao">
            <td class="px-4 py-3.5 sm:px-6">
              <p class="font-medium text-navy">{l.ferramenta}</p>
              <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted md:hidden">
                <span class="flex items-center gap-1.5 whitespace-nowrap">
                  {l.logos.map((src) => (
                    <img src={src} alt="" width="18" height="18" loading="lazy" class="size-[18px] rounded-md object-contain" />
                  ))}
                  {l.concorrente}
                </span>
                <span class="whitespace-nowrap rounded-md bg-canvas px-1.5 py-0.5 font-mono text-[11px] text-navy">{l.preco}</span>
              </p>
            </td>
            <td class="hidden px-4 py-3.5 md:table-cell md:px-6">
              <div class="flex items-center gap-3">
                <span class="flex items-center -space-x-1.5">
                  {l.logos.map((src) => (
                    <img src={src} alt="" width="28" height="28" loading="lazy" class="size-7 rounded-lg border border-line bg-white object-contain p-0.5" />
                  ))}
                </span>
                <span class="text-navy">{l.concorrente}</span>
                <span class="ml-auto whitespace-nowrap font-mono text-xs text-muted">{l.preco}</span>
              </div>
            </td>
            <td class="px-4 py-3.5 text-right sm:px-6">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-success/15 px-2.5 py-1 text-xs font-bold text-[#1f8f43]">
                <Icone nome="Check" class="size-3.5" strokeWidth={3} />
                {COMPARATIVO.incluso}
              </span>
            </td>
          </tr>
        ))}
        <tr class="border-t-2 border-navy bg-canvas">
          <td class="px-4 py-4 sm:px-6">
            <p class="text-xs font-bold uppercase tracking-wide text-muted">{COMPARATIVO.totalSeparado.rotulo}</p>
            <p class="garrafal-sm mt-0.5 text-lg text-navy md:hidden">{COMPARATIVO.totalSeparado.valor}</p>
          </td>
          <td class="hidden px-4 py-4 md:table-cell md:px-6">
            <p class="garrafal-sm text-xl text-navy">{COMPARATIVO.totalSeparado.valor}</p>
          </td>
          <td class="px-4 py-4 text-right sm:px-6">
            <p class="text-xs font-bold uppercase tracking-wide text-brand">{COMPARATIVO.totalNucleo.rotulo}</p>
            <p class="garrafal-sm mt-0.5 text-xl text-brand">{COMPARATIVO.totalNucleo.valor}</p>
          </td>
        </tr>
      </tbody>
    </table>
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 border-t border-line bg-navy px-6 py-4 text-sm font-semibold text-white">
      {COMPARATIVO.garantias.map((g) => (
        <span class="inline-flex items-center gap-2"><Icone nome="ShieldCheck" class="size-4 text-success" /> {g}</span>
      ))}
    </div>
  </div>
  <p class="mt-3 text-xs text-muted" data-anim="sobe">{COMPARATIVO.nota}</p>
</Secao>
