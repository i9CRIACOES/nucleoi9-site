---
import Icone from "../Icone.astro";
import Secao from "../Secao.astro";
import Titulo from "../Titulo.astro";
import { AGENTES } from "../../lib/conteudo";
import AgenteOrbe from "../../react/AgenteOrbe";
import RoboIA from "../RoboIA.astro";
import ConversaAgente from "../../react/ConversaAgente";
import MontarAgente from "../../react/MontarAgente";
---

<Secao id="agentes" escura>
  <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-brand-light" data-anim="sobe">
        <Icone nome="Bot" class="size-4" />
        {AGENTES.selo}
      </p>
      <Titulo linhas={AGENTES.titulo} claro />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-sidebar-fg" data-anim="sobe">{AGENTES.sub}</p>
    </div>

    <div class="flex flex-col items-center gap-6" data-anim="sobe">
      <RoboIA chips={AGENTES.orbitais} />
      <blockquote class="relative w-full rounded-panel border border-brand-light/30 bg-gradient-to-br from-brand/30 to-navy-light/40 p-7 lg:p-8">
        <span class="absolute -top-4 left-7 inline-flex items-center gap-1.5 rounded-full bg-success px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-navy">
          <Icone nome="Sparkles" class="size-3.5" strokeWidth={2.5} /> Texto e voz · 24 h
        </span>
        <p class="garrafal text-[clamp(1.5rem,2.6vw,2.1rem)] text-white">{AGENTES.destaque[0]}</p>
        <p class="garrafal-sm mt-1 text-[clamp(1.05rem,1.6vw,1.3rem)] text-brand-light">{AGENTES.destaque[1]}</p>
        <p class="mt-4 text-base leading-relaxed text-sidebar-fg">{AGENTES.destaqueTexto}</p>
      </blockquote>
    </div>
  </div>

  <div class="mt-14 grid items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
    <div class="rounded-panel border border-white/10 bg-[#0b2436]/60 px-6 py-10" data-anim="sobe">
      <AgenteOrbe client:visible={{ rootMargin: "200px" }} />
    </div>

    <div data-anim="sobe">
      <ConversaAgente client:visible={{ rootMargin: "200px" }} />
    </div>
  </div>

  <ul class="carrossel mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-5 [--slide:74%]" data-anim-grupo>
    {AGENTES.pontos.map((p) => (
      <li class="rounded-card border border-white/10 bg-white/5 p-4" data-anim="cartao">
        <div class="mb-2 flex items-center gap-2 text-brand-light">
          <Icone nome={p.icone} class="size-5" />
          <h3 class="font-semibold text-white">{p.titulo}</h3>
        </div>
        <p class="text-sm text-sidebar-fg">{p.texto}</p>
      </li>
    ))}
  </ul>

  <div class="mt-16 border-t border-white/10 pt-14">
    <div class="mb-10 max-w-3xl">
      <Titulo linhas={AGENTES.montar.titulo} claro />
      <p class="mt-5 text-lg leading-relaxed text-sidebar-fg" data-anim="sobe">{AGENTES.montar.sub}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1.45fr_1fr] lg:gap-10">
      <div class="min-w-0" data-anim="sobe">
        <MontarAgente client:visible={{ rootMargin: "200px" }} />
      </div>

      <ul class="carrossel grid gap-3 sm:grid-cols-2 lg:grid-cols-1 [--slide:84%]" data-anim-grupo>
        {AGENTES.montar.argumentos.map((a) => (
          <li class="flex gap-3 rounded-card border border-white/10 bg-white/5 p-4" data-anim="cartao">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand/25 text-brand-light"><Icone nome={a.icone} class="size-4.5" /></span>
            <div>
              <h3 class="font-semibold text-white">{a.titulo}</h3>
              <p class="mt-1 text-sm text-sidebar-fg">{a.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Secao>
