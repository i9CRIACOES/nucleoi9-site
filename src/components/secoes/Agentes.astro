---
import Icone from "../Icone.astro";
import Secao from "../Secao.astro";
import Titulo from "../Titulo.astro";
import { AGENTES } from "../../lib/conteudo";
import AgenteOrbe from "../../react/AgenteOrbe";
import RoboIA from "../RoboIA.astro";
---

<Secao id="agentes" escura>
  <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-brand-light" data-anim="sobe">
        <Icone nome="Bot" class="size-4" />
        {AGENTES.selo}
      </p>
      <Titulo linhas={AGENTES.titulo} claro />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-sidebar-fg" data-anim="sobe">{AGENTES.sub}</p>
    </div>

    <div class="flex flex-col items-center gap-6" data-anim="sobe">
      <RoboIA chips={AGENTES.orbitais} />
      <blockquote class="relative w-full rounded-panel border border-brand-light/30 bg-gradient-to-br from-brand/30 to-navy-light/40 p-7 lg:p-8">
        <span class="absolute -top-4 left-7 inline-flex items-center gap-1.5 rounded-full bg-success px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-navy">
          <Icone nome="Sparkles" class="size-3.5" strokeWidth={2.5} /> Texto e voz · 24 h
        </span>
        <p class="garrafal text-[clamp(1.5rem,2.6vw,2.1rem)] text-white">{AGENTES.destaque[0]}</p>
        <p class="garrafal-sm mt-1 text-[clamp(1.05rem,1.6vw,1.3rem)] text-brand-light">{AGENTES.destaque[1]}</p>
        <p class="mt-4 text-base leading-relaxed text-sidebar-fg">{AGENTES.destaqueTexto}</p>
      </blockquote>
    </div>
  </div>

  <div class="mt-14 grid items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
    <div class="rounded-panel border border-white/10 bg-[#0b2436]/60 px-6 py-10" data-anim="sobe">
      <AgenteOrbe client:visible={{ rootMargin: "200px" }} />
    </div>

    <div class="mx-auto w-full max-w-sm" data-anim="sobe">
      <div class="rounded-[2rem] border border-white/10 bg-[#0b2436] p-3 shadow-soft">
        <div class="flex items-center gap-3 rounded-t-[1.5rem] bg-[#184e6c] px-4 py-3">
          <span class="flex size-9 items-center justify-center rounded-full bg-brand-light text-white"><Icone nome="Bot" class="size-5" /></span>
          <div class="leading-tight">
            <p class="text-sm font-semibold text-white">Assistente · Clínica Viva</p>
            <p class="text-[11px] text-success">Agente iA ligado</p>
          </div>
          <span class="ml-auto inline-flex h-6 w-11 items-center rounded-full bg-success p-0.5" aria-label="Agente iA ligado"><span class="ml-auto size-5 rounded-full bg-white"></span></span>
        </div>
        <ol class="flex flex-col gap-2 rounded-b-[1.5rem] bg-[#0f3349] p-4" data-conversa-ia>
          {AGENTES.conversa.map((m) => (
            <li
              class:list={[
                "max-w-[85%] rounded-2xl px-3.5 py-2 text-sm leading-snug",
                m.de === "cliente" && "self-start rounded-bl-md bg-white text-ink",
                m.de === "ia" && "self-end rounded-br-md bg-brand text-white",
                m.de === "sistema" && "max-w-full self-center rounded-lg bg-success/20 px-3 py-1.5 text-center text-xs font-semibold text-success",
              ]}
              data-msg
            >
              {m.texto}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" data-anim-grupo>
    {AGENTES.pontos.map((p) => (
      <li class="rounded-card border border-white/10 bg-white/5 p-4" data-anim="cartao">
        <div class="mb-2 flex items-center gap-2 text-brand-light">
          <Icone nome={p.icone} class="size-5" />
          <h3 class="font-semibold text-white">{p.titulo}</h3>
        </div>
        <p class="text-sm text-sidebar-fg">{p.texto}</p>
      </li>
    ))}
  </ul>

  <div class="mt-16 border-t border-white/10 pt-14">
    <div class="mb-10 max-w-3xl">
      <Titulo linhas={AGENTES.montar.titulo} claro />
      <p class="mt-5 text-lg leading-relaxed text-sidebar-fg" data-anim="sobe">{AGENTES.montar.sub}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
      <div class="flex flex-col gap-4" data-anim="sobe">
        <div class="overflow-hidden rounded-panel border border-line bg-white shadow-soft">
          <div class="flex items-center justify-between border-b border-line px-5 py-3">
            <div>
              <p class="font-semibold text-navy">Agentes iA</p>
              <p class="text-[11px] text-muted">Atendem primeiro no WhatsApp; a equipe acompanha e assume quando quiser.</p>
            </div>
            <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-800">Módulo</span>
          </div>
          <div class="flex gap-1 bg-canvas px-5 py-2 text-xs font-semibold">
            <span class="rounded-md px-3 py-1 text-muted">Painel</span>
            <span class="rounded-md bg-white px-3 py-1 text-navy shadow-card">Lista de Agentes iA</span>
          </div>
          <p class="px-5 pt-3 text-[10px] font-bold uppercase tracking-wide text-muted">Principais</p>
          <ul class="flex flex-col gap-2 p-5 pt-2" data-anim-grupo>
            {AGENTES.montar.agentes.map((a) => (
              <li class="flex items-center gap-3 rounded-xl border border-line p-3" data-anim="cartao">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white" style={`background:${a.cor}`}>{a.iniciais}</span>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-navy">{a.nome}</p>
                  <p class="truncate text-[11px] text-muted">{a.papel}</p>
                  <div class="mt-1.5 flex flex-wrap gap-1">
                    {a.chips.map((c) => (
                      <span class:list={["rounded-full px-2 py-0.5 text-[10px] font-medium", c === "Ligado" ? "bg-success/15 text-[#1f8f43]" : "bg-canvas text-muted"]}>{c}</span>
                    ))}
                  </div>
                </div>
                <Icone nome="EllipsisVertical" class="size-4 text-muted" />
              </li>
            ))}
          </ul>
        </div>

        <div class="overflow-hidden rounded-panel border border-line bg-white shadow-soft">
          <div class="flex items-center gap-3 border-b border-line px-5 py-3">
            <span class="flex size-10 items-center justify-center rounded-full bg-success text-xs font-bold text-white">IS</span>
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-navy">Isa | Atendimento</p>
              <div class="mt-1 flex items-center gap-2">
                <span class="h-1.5 w-40 overflow-hidden rounded-full bg-line"><span class="block h-full w-[89%] rounded-full bg-success"></span></span>
                <span class="text-[11px] text-muted">8 de 9 passos</span>
              </div>
            </div>
            <span class="inline-flex h-8 items-center gap-1.5 rounded-lg bg-navy px-3 text-xs font-semibold text-white"><Icone nome="Rocket" class="size-3.5" /> Publicar</span>
          </div>
          <ol class="grid grid-cols-3 gap-x-1 gap-y-4 px-4 py-4 sm:grid-cols-5 xl:grid-cols-9" data-anim-grupo>
            {AGENTES.montar.passos.map((p, i) => (
              <li class="flex flex-col items-center gap-1.5 text-center" data-anim="cartao">
                <span class:list={["flex size-8 items-center justify-center rounded-full border-2", i === 7 ? "border-line bg-white text-xs font-bold text-muted" : "border-success bg-success text-white"]}>
                  {i === 7 ? "8" : <Icone nome="Check" class="size-4" strokeWidth={3} />}
                </span>
                <span class="text-[9.5px] font-medium leading-tight text-navy [overflow-wrap:anywhere]">{p.nome}</span>
                <span class="text-[9px] uppercase tracking-wide text-muted">{p.grupo}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1" data-anim-grupo>
        {AGENTES.montar.argumentos.map((a) => (
          <li class="flex gap-3 rounded-card border border-white/10 bg-white/5 p-4" data-anim="cartao">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand/25 text-brand-light"><Icone nome={a.icone} class="size-4.5" /></span>
            <div>
              <h3 class="font-semibold text-white">{a.titulo}</h3>
              <p class="mt-1 text-sm text-sidebar-fg">{a.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Secao>
