---
import { RODAPE } from "../lib/conteudo";
import { EMAIL_CONTATO } from "../lib/config";
---

<footer class="border-t border-line bg-white pb-24 pt-12 lg:pb-12">
  <div class="container-site flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div class="flex items-start gap-4">
      <img src="/marca/nucleo-i9-vertical.svg" alt="Núcleo i9" width="64" height="81" class="h-20 w-auto" />
      <div class="text-sm leading-relaxed text-muted">
        <p>
          {RODAPE.empresa.replace("i9 Criações.", "")}
          <a href="https://i9criacoes.com.br/" rel="noopener" class="font-semibold text-brand-logo hover:underline">i9 Criações</a>.
        </p>
        <p>{RODAPE.razao}</p>
        <p>&copy; {new Date().getFullYear()} i9 Criações</p>
      </div>
    </div>
    <nav aria-label="Documentos legais" class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-brand-logo">
      {RODAPE.links.map((l) => (
        <a href={l.href} class="hover:underline">{l.label}</a>
      ))}
      <a href={`mailto:${EMAIL_CONTATO}`} class="hover:underline">{EMAIL_CONTATO}</a>
    </nav>
  </div>
</footer>
